{
  "$description": "Verdex Advisor (B2B sub-brand) token overrides. Same --vx- 3-tier structure as the base Verdex DS; the advisor surface re-themes the action-primary hue (a cooler, data-dense indigo) for its enterprise dashboard, leaving the rest of the system intact. This is the sub-brand mechanism (CC-47): a separate client config + a small token override, NOT an engine code change. The differing --vx-color-action-primary value is what a genericity test asserts diverges from the base verdex tokens.",
  "primitive": {
    "--vx-palette-indigo-600": {
      "light": "#3538cd",
      "dark": "#3538cd",
      "hc-light": "#2d2f9e",
      "hc-dark": "#3538cd"
    },
    "--vx-palette-neutral-0": {
      "light": "#ffffff",
      "dark": "#ffffff",
      "hc-light": "#ffffff",
      "hc-dark": "#ffffff"
    },
    "--vx-palette-neutral-900": {
      "light": "#0a0e14",
      "dark": "#0a0e14",
      "hc-light": "#0a0e14",
      "hc-dark": "#0a0e14"
    }
  },
  "semantic": {
    "--vx-color-action-primary": {
      "light": "var(--vx-palette-indigo-600)",
      "dark": "var(--vx-palette-indigo-600)",
      "hc-light": "var(--vx-palette-indigo-600)",
      "hc-dark": "var(--vx-palette-indigo-600)"
    },
    "--vx-color-text-default": {
      "light": "var(--vx-palette-neutral-900)",
      "dark": "var(--vx-palette-neutral-0)",
      "hc-light": "var(--vx-palette-neutral-900)",
      "hc-dark": "var(--vx-palette-neutral-0)"
    }
  },
  "component": {
    "--vx-btn-bg-default": {
      "light": "var(--vx-color-action-primary)",
      "dark": "var(--vx-color-action-primary)",
      "hc-light": "var(--vx-color-action-primary)",
      "hc-dark": "var(--vx-color-action-primary)"
    }
  }
}
