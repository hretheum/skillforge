    "--vx-palette-blue-500": {
      "light": "#1b6ef3",
      "dark": "#1b6ef3",
      "hc-light": "#1b6ef3",
      "hc-dark": "#1b6ef3"
    },
    "--vx-palette-blue-700": {
      "light": "#0f49a8",
      "dark": "#0f49a8",
      "hc-light": "#0f49a8",
      "hc-dark": "#0f49a8"
    },
    "--vx-palette-neutral-0": {
      "light": "#ffffff",
      "dark": "#ffffff",
      "hc-light": "#ffffff",
      "hc-dark": "#ffffff"
    },
    "--vx-palette-neutral-900": {
      "light": "#0a0e14",
      "dark": "#0a0e14",
      "hc-light": "#0a0e14",
      "hc-dark": "#0a0e14"
    },
